# =============================================================================
# Ronds Pocket - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values
# DO NOT commit .env.local or .env.keys to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Convex Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from running 'npx convex dev'
# Or from your Convex dashboard: https://dashboard.convex.dev

# Convex deployment URL - frontend client
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Site URL for authentication callbacks
# Development: http://localhost:5173
# Production: https://your-domain.com
CONVEX_SITE_URL=http://localhost:5173

# Deployment identifier
CONVEX_DEPLOYMENT=dev:your-deployment-name

# -----------------------------------------------------------------------------
# VLY Integration (OPTIONAL - Email OTP)
# -----------------------------------------------------------------------------
# Required for email-based sign-in/OTP
# Get from: https://freebuff.com or VLY dashboard

VLY_INTEGRATION_KEY=
VLY_INTEGRATION_BASE_URL=https://integrations.vly.ai
VLY_CONVEX_AUTH_ISSUER=https://freebuff.com

# -----------------------------------------------------------------------------
# Resend (OPTIONAL - Feedback Emails)
# -----------------------------------------------------------------------------
# Required for sending feedback emails
# Get from: https://resend.com/api-keys

RESEND_API_KEY=
FEEDBACK_INBOX=your-email@domain.com
FEEDBACK_FROM=

# -----------------------------------------------------------------------------
# Gemini AI (OPTIONAL - AI Composer)
# -----------------------------------------------------------------------------
# Required for AI transaction composer feature
# Get from: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# VLY Monitoring (OPTIONAL - Analytics)
# -----------------------------------------------------------------------------
# Optional monitoring and analytics

VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
# Set to 'production' for production deployments
NODE_ENV=development
